{
  "name": "flashrush-backend",
  "version": "1.0.0",
  "private": true,
  "description": "FlashRush API and background worker",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "migrate": "node dist/migrate-cli.js"
  },
  "dependencies": {
    "bullmq": "~5.34.0",
    "cors": "~2.8.5",
    "express": "~4.21.2",
    "ioredis": "~5.4.2",
    "pg": "~8.13.1",
    "pino": "~9.6.0",
    "zod": "~3.24.1",
    "swagger-ui-express": "~5.0.1"
  },
  "devDependencies": {
    "@types/cors": "~2.8.17",
    "@types/express": "~4.17.21",
    "@types/node": "~22.10.2",
    "@types/pg": "~8.11.10",
    "@types/supertest": "~6.0.2",
    "supertest": "~7.0.0",
    "typescript": "~5.7.2",
    "vitest": "~2.1.8",
    "@types/swagger-ui-express": "~4.1.8"
  }
}
